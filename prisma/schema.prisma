generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  name      String
  password  String
  type      UserType @default(USER)

  reports   Report[]
  forms     Form[]   

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum UserType {
  ADMIN
  VENDOR
  USER
}

model Form {
  id          String     @id @default(uuid())
  title       String
  description String?

  sections    Section[]  // instead of inputs directly
  reports     Report[]
  createdBy   String
  admin       User       @relation(fields: [createdBy], references: [id])

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Section {
  id        String   @id @default(uuid())
  title     String?
  position  Int      // position of section within form

  formId    String
  form      Form     @relation(fields: [formId], references: [id])

  rows      Row[]
}

model Row {
  id        String   @id @default(uuid())
  position  Int      // position of row within section

  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])

  inputs    Input[]
}

model Input {
  id        String   @id @default(uuid())
  label     String
  type      InputType
  position  Int      // position of input within row
  required  Boolean  @default(false)
  options   Json?     // for complicated inputs

  rowId     String
  row       Row      @relation(fields: [rowId], references: [id])

  entries   ReportEntry[]
}

enum InputType {
  TEXT
  TEXTAREA
  URL
  EMAIL
  TEL
  NUMBER
  SELECT
  TOGGLE
  FILE
  BAR
  LINE
  TABLE
}

model Report {
  id          String      @id @default(uuid())
  
  title       String?
  description String?
  
  formId      String
  form        Form        @relation(fields: [formId], references: [id])
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  
  entries     ReportEntry[]
  status      ReportStatus @default(PENDING)
  certificate String?      // path/URL to uploaded PDF
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum ReportStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model ReportEntry {
  id        String    @id @default(uuid())
  
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id])
  inputId   String
  input     Input     @relation(fields: [inputId], references: [id])
  
  value     Json      // flexible: text, number, file path, structured graph/table data
  
  @@unique([reportId, inputId])
}